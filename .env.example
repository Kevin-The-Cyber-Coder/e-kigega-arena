# Copy this file to .env and change the values if you want to.
PORT=3000
MONGODB_URI=mongodb://localhost:27017/IMS

# Used to sign the login cookie. Replace with any long random text.
SESSION_SECRET=change-this-to-a-long-random-text

# The default super admin is created automatically when no super admin exists.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=superadmin123
