{
  "info": {
    "name": "E-Kigega Arena Inventory API",
    "description": "Backend-only inventory API. Run the requests in order (or use the Collection Runner). Login stores the session cookie automatically. The default super admin creates a sub admin, the sub admin creates day and night staff, and products show who added them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "superAdminEmail", "value": "superadmin@example.com" },
    { "key": "superAdminPassword", "value": "superadmin123" },
    { "key": "superAdminName", "value": "Super Admin" },
    { "key": "adminEmail", "value": "" },
    { "key": "adminPassword", "value": "admin123" },
    { "key": "staffEmail", "value": "" },
    { "key": "staffPassword", "value": "staff123" },
    { "key": "productId", "value": "" },
    { "key": "productName", "value": "Postman Notebook" },
    { "key": "userId", "value": "" },
    { "key": "subAdminId", "value": "" },
    { "key": "staffId", "value": "" }
  ],
  "item": [
    {
      "name": "01. API info",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api",
        "description": "Shows that the API is running and lists all endpoints."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Login as super admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/login",
        "description": "Run this first with the default credentials from .env.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Logged in as super_admin', () => pm.expect(pm.response.json().user.role).to.eql('super_admin'));",
              "pm.collectionVariables.set('superAdminName', pm.response.json().user.name);"
            ]
          }
        }
      ]
    },
    {
      "name": "03. Get current user",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04. Get dashboard",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/dashboard"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05. Create sub admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/users/admins",
        "description": "Only the super admin can create a sub admin.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sub Admin\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('adminEmail') || pm.collectionVariables.get('adminEmail').includes('{{$timestamp}}')) { pm.collectionVariables.set('adminEmail', 'subadmin.' + Date.now() + '@example.com'); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Role is admin', () => pm.expect(pm.response.json().user.role).to.eql('admin'));",
              "pm.collectionVariables.set('subAdminId', pm.response.json().user._id);",
              "pm.collectionVariables.set('adminEmail', pm.response.json().user.email);"
            ]
          }
        }
      ]
    },
    {
      "name": "06. Login as sub admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Logged in as admin', () => pm.expect(pm.response.json().user.role).to.eql('admin'));"
            ]
          }
        }
      ]
    },
    {
      "name": "07. Create day shift staff",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/users/staff",
        "description": "The sub admin creates a staff member for the day shift.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Day Staff\",\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{staffPassword}}\",\n  \"shift\": \"day\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('staffEmail') || pm.collectionVariables.get('staffEmail').includes('{{$timestamp}}')) { pm.collectionVariables.set('staffEmail', 'daystaff.' + Date.now() + '@example.com'); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Shift is day', () => pm.expect(pm.response.json().user.shift).to.eql('day'));",
              "pm.collectionVariables.set('staffId', pm.response.json().user._id);",
              "pm.collectionVariables.set('staffEmail', pm.response.json().user.email);"
            ]
          }
        }
      ]
    },
    {
      "name": "08. Create night shift staff",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/users/staff",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Night Staff\",\n  \"email\": \"nightstaff.{{$timestamp}}@example.com\",\n  \"password\": \"{{staffPassword}}\",\n  \"shift\": \"night\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Shift is night', () => pm.expect(pm.response.json().user.shift).to.eql('night'));"
            ]
          }
        }
      ]
    },
    {
      "name": "09. Assign role and shift",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/users/{{staffId}}/role",
        "description": "An admin can assign manager or staff roles. Staff need a shift.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role\": \"staff\",\n  \"shift\": \"night\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Shift changed to night', () => pm.expect(pm.response.json().user.shift).to.eql('night'));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Change staff shift",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/users/{{staffId}}/shift",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shift\": \"day\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Shift changed to day', () => pm.expect(pm.response.json().user.shift).to.eql('day'));"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Get staff by role and shift",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/users?role=staff&shift=day"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Get available roles and shifts",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/users/roles"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Login as super admin again",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "14. Get all products",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json(); if (!pm.collectionVariables.get('productId') && body.products.length) { pm.collectionVariables.set('productId', body.products[0]._id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "15. Create product (added by is saved)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/products",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{productName}}\",\n  \"price\": 6.5,\n  \"quantity\": 5,\n  \"minStock\": 2\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('productName', 'Postman Notebook ' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Product shows who added it', () => pm.expect(body.product.addedByName).to.eql(pm.collectionVariables.get('superAdminName')));",
              "pm.collectionVariables.set('productId', body.product._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "16. Get product by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Added by is present', () => pm.expect(pm.response.json().product.addedByName).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "17. Update product",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/products/{{productId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{productName}} Updated\",\n  \"price\": 7.25,\n  \"quantity\": 5,\n  \"minStock\": 3\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Updated by is present', () => pm.expect(pm.response.json().product.updatedByName).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "18. Stock in",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/stock/in",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"amount\": 5\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "19. Stock out",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/stock/out",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"amount\": 2\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "20. Get stock and movements",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/stock"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "21. Get user by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/users/{{staffId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "22. Delete staff",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/users/{{staffId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "23. Delete sub admin",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/users/{{subAdminId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "24. Delete product",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "25. Logout",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
