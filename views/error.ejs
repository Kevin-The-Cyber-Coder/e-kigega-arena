<%- include('partials/head') %>
<% if (currentUser) { %>
  <%- include('partials/nav') %>
<% } %>

<main class="<%= currentUser ? 'shell page' : 'login-page' %>">
  <section class="<%= currentUser ? 'card error-card' : 'login-card error-card' %>">
    <p class="error-status"><%= status %></p>
    <h1><%= title %></h1>
    <p class="muted"><%= message %></p>
    <a href="<%= currentUser ? '/dashboard' : '/login' %>" class="button primary">
      <%= currentUser ? 'Back to dashboard' : 'Go to login' %>
    </a>
  </section>
</main>

<%- include('partials/foot') %>
