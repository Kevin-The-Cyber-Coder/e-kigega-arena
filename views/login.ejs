<%- include('partials/head') %>

<main class="login-page">
  <section class="login-card">
    <div class="login-brand">
      <span class="brand-mark" aria-hidden="true">SI</span>
    </div>

    <h1>Simple Inventory</h1>
    <p class="login-intro">Log in to manage products and keep track of stock.</p>

    <%- include('partials/flash') %>

    <% if (error) { %>
      <div class="alert alert-error" role="alert"><%= error %></div>
    <% } %>

    <form action="/login" method="POST" class="stack">
      <label>
        Email
        <input
          type="email"
          name="email"
          value="<%= email %>"
          autocomplete="email"
          placeholder="you@example.com"
          required
          autofocus
        >
      </label>

      <label>
        Password
        <input
          type="password"
          name="password"
          autocomplete="current-password"
          placeholder="Your password"
          required
        >
      </label>

      <button type="submit" class="button primary wide">Log in</button>
    </form>

    <p class="login-help">Use the account your admin created for you.</p>
  </section>
</main>

<%- include('partials/foot') %>
