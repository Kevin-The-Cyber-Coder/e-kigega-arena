<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="shell page">
  <div class="page-head">
    <div>
      <p class="eyebrow">Stock</p>
      <h1>Stock</h1>
      <p>Add the items that arrive. Remove the items that are sold or used.</p>
    </div>
  </div>

  <%- include('partials/flash') %>

  <% if (products.length === 0) { %>
    <div class="alert alert-info">
      There are no products yet. Ask an admin or manager to add one before changing stock.
    </div>
  <% } else { %>
    <div class="stock-grid">
      <section class="card stock-card stock-in">
        <div class="card-head">
          <div>
            <h2>Stock in</h2>
            <p>Use this when new items arrive.</p>
          </div>
          <span class="badge badge-success">Add</span>
        </div>

        <form action="/stock/in" method="POST" class="stack">
          <label>
            Product
            <select name="productId" required>
              <option value="">Choose a product</option>
              <% products.forEach((product) => { %>
                <option value="<%= product._id %>"><%= product.name %> (<%= product.quantity %> in stock)</option>
              <% }) %>
            </select>
          </label>

          <label>
            Quantity to add
            <input type="number" name="amount" min="1" step="1" placeholder="e.g. 10" required>
          </label>

          <button type="submit" class="button success">Add stock</button>
        </form>
      </section>

      <section class="card stock-card stock-out">
        <div class="card-head">
          <div>
            <h2>Stock out</h2>
            <p>Use this when items are sold or used.</p>
          </div>
          <span class="badge badge-danger">Remove</span>
        </div>

        <form action="/stock/out" method="POST" class="stack">
          <label>
            Product
            <select name="productId" required>
              <option value="">Choose a product</option>
              <% products.forEach((product) => { %>
                <option value="<%= product._id %>"><%= product.name %> (<%= product.quantity %> in stock)</option>
              <% }) %>
            </select>
          </label>

          <label>
            Quantity to remove
            <input type="number" name="amount" min="1" step="1" placeholder="e.g. 2" required>
          </label>

          <button type="submit" class="button danger">Remove stock</button>
        </form>
      </section>
    </div>
  <% } %>

  <section class="card">
    <div class="card-head">
      <div>
        <h2>Recent stock movements</h2>
        <p>The latest 12 stock changes.</p>
      </div>
      <a href="/products" class="text-link">View products</a>
    </div>

    <% if (movements.length === 0) { %>
      <div class="empty-state">
        <strong>No stock changes yet.</strong>
        <p>Your first stock in or stock out will appear here.</p>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Product</th>
              <th class="num">Change</th>
              <th>By</th>
              <th>When</th>
            </tr>
          </thead>
          <tbody>
            <% movements.forEach((movement) => { %>
              <tr>
                <td><span class="product-name"><%= movement.productName %></span></td>
                <td class="num">
                  <% if (movement.type === 'stock_in') { %>
                    <span class="amount-in">+<%= movement.amount %></span>
                  <% } else { %>
                    <span class="amount-out">&minus;<%= movement.amount %></span>
                  <% } %>
                </td>
                <td><%= movement.actorName %></td>
                <td class="nowrap"><%= formatDate(movement.createdAt) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>

<%- include('partials/foot') %>
