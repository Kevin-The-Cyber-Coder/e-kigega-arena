<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="shell page">
  <div class="page-head">
    <div>
      <p class="eyebrow">Admin only</p>
      <h1>Users</h1>
      <p>Create accounts and choose what each person is allowed to do.</p>
    </div>
  </div>

  <%- include('partials/flash') %>

  <% if (errors.length > 0) { %>
    <div class="alert alert-error" role="alert">
      <strong>Please check the form:</strong>
      <ul>
        <% errors.forEach((error) => { %>
          <li><%= error %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <section class="card form-card">
    <div class="card-head">
      <div>
        <h2>Add a user</h2>
        <p>Give the person a login and a role.</p>
      </div>
    </div>

    <form action="/users" method="POST" class="form-grid">
      <label>
        Full name
        <input type="text" name="name" value="<%= values.name %>" maxlength="60" placeholder="e.g. Sam Lee" required>
      </label>

      <label>
        Email
        <input type="email" name="email" value="<%= values.email %>" placeholder="sam@example.com" required>
      </label>

      <label>
        Temporary password
        <input type="password" name="password" minlength="6" placeholder="At least 6 characters" required>
      </label>

      <label>
        Role
        <select name="role" required>
          <option value="staff" <%= values.role === 'staff' ? 'selected' : '' %>>Staff</option>
          <option value="manager" <%= values.role === 'manager' ? 'selected' : '' %>>Manager</option>
          <option value="admin" <%= values.role === 'admin' ? 'selected' : '' %>>Admin</option>
        </select>
        <span class="field-hint">Staff: stock only. Manager: products and stock. Admin: everything.</span>
      </label>

      <div class="form-actions">
        <button type="submit" class="button primary">Add user</button>
      </div>
    </form>
  </section>

  <section class="card">
    <div class="card-head">
      <div>
        <h2>Team <span class="count"><%= users.length %></span></h2>
        <p>You cannot remove your own account or the last admin.</p>
      </div>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>User</th>
            <th>Email</th>
            <th>Role</th>
            <th>Joined</th>
            <th class="actions">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach((user) => { %>
            <tr>
              <td>
                <span class="product-name"><%= user.name %></span>
                <% if (String(user._id) === String(currentUser._id)) { %>
                  <span class="row-note">That is you</span>
                <% } %>
              </td>
              <td><%= user.email %></td>
              <td><span class="role-badge role-<%= user.role %>"><%= roleLabel(user.role) %></span></td>
              <td class="nowrap"><%= formatDate(user.createdAt) %></td>
              <td class="actions">
                <% if (String(user._id) === String(currentUser._id)) { %>
                  <span class="muted small">Current account</span>
                <% } else { %>
                  <form
                    action="/users/<%= user._id %>/delete"
                    method="POST"
                    class="inline-form"
                    data-confirm="Remove <%= user.name %>? They will no longer be able to log in."
                  >
                    <button type="submit" class="small-button danger">Remove</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</main>

<%- include('partials/foot') %>
